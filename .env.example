# این فایل رو کپی کن به اسم .env و مقادیر رو پر کن
# cp .env.example .env

# توکن ربات از @BotFather (اجباری)
BOT_TOKEN=your_bot_token_here

# مسیر فایل دیتابیس (اختیاری؛ مسیر نسبی همیشه نسبت به پوشه پروژه باز می‌شود، نه پوشه جاری اجرا)
DB_PATH=birthdays.db

# ساعت و دقیقه ارسال یادآوری روزانه (اختیاری)
REMINDER_HOUR=9
REMINDER_MINUTE=0

# منطقه زمانی (اختیاری)
TIMEZONE=Asia/Tehran

# سطح لاگ: DEBUG / INFO / WARNING / ERROR (اختیاری)
LOG_LEVEL=INFO

# آیدی عددی ادمین‌ها با کاما جدا شده (از @userinfobot بگیر)
ADMIN_IDS=123456789,987654321

# حداکثر پیام ارسالی در ثانیه برای ارسال انبوه (اختیاری، حداکثر ۳۰)
SEND_RATE=25

# Maximum Telegram updates the polling process handles at once (1-256)
UPDATE_CONCURRENCY=32

# Public HTTPS URL where the date-converter Mini App is hosted (optional)
WEBAPP_URL=

# Mini App profile/friends API listens locally; expose only through an HTTPS tunnel/proxy
WEBAPP_API_HOST=127.0.0.1
WEBAPP_API_PORT=8080
# Comma-separated allowed web app origins; WEBAPP_URL's origin is allowed automatically
WEBAPP_API_ALLOWED_ORIGINS=
